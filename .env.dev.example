# 食刻 · 本地开发环境配置模板
# 复制为 .env.dev 并填入真实值:.env.dev 不会被 git 追踪(.gitignore 已忽略 .env*)

# ── 数据库(shike/config.py;都有默认值,通常只填密码)──────────────────
SHIKE_DB_HOST=127.0.0.1
SHIKE_DB_PORT=3306
SHIKE_DB_USER=root
SHIKE_DB_PASSWORD=改成你的MySQL密码
SHIKE_DB_NAME=shike

# ── LLM 默认档案(llm/config.py;PROVIDER=档案名,须与下方某组三件套对应)──
SHIKE_LLM_PROVIDER=glm
SHIKE_LLM_GLM_API_KEY=你的智谱APIKey
SHIKE_LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SHIKE_LLM_GLM_MODEL=glm-4.6

# 第二个档案示例(按需保留;tests/test_llm_config.py 依赖 glm+deepseek 两组都在)
# SHIKE_LLM_DEEPSEEK_API_KEY=你的DeepSeekAPIKey
# SHIKE_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SHIKE_LLM_DEEPSEEK_MODEL=deepseek-chat

# ── LLM 角色分流(可选,不配则全部用 PROVIDER 档案)──────────────────────
# 食材流水线
# SHIKE_LLM_ROLE_RECOMMEND=glm
# SHIKE_LLM_ROLE_FILL=glm
# SHIKE_LLM_ROLE_VERIFY=deepseek
# 健康厨师菜品流水线
# SHIKE_LLM_ROLE_CHEF=glm
# SHIKE_LLM_ROLE_DISH_VERIFY=deepseek
# 美食大厨流水线(大厨建议配更强模型:正宗性判断依赖模型的知识面)
# SHIKE_LLM_ROLE_CUISINE_CHEF=glm
# SHIKE_LLM_ROLE_CUISINE_VERIFY=deepseek

# ── JWT 鉴权(web/auth.py;SECRET 必填,终端执行 openssl rand -hex 32 生成)──
# SHIKE_JWT_SECRET=openssl生成的64位hex
# SHIKE_JWT_ACCESS_EXPIRE_HOURS=2
# SHIKE_JWT_REFRESH_EXPIRE_DAYS=30

# ── 环境(可选,dev|prod,默认 dev;决定加载 .env.dev 还是 .env.prod)──────
# SHIKE_ENV=dev
